NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-url>/pdf_extractor?retryWrites=true&w=majority&appName=<app-name>
# Optional local example only; runtime continues to use MONGODB_URI
MONGODB_URI_LOCAL=mongodb://localhost:27017/pdf_extractor
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=pdf-projects
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=26214400
NEXT_PUBLIC_MAX_UPLOAD_BYTES=26214400
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Development Admin
PYTHON_WORKER_URL=http://worker:8000
EXTRACTION_TIMEOUT_MS=600000
OCR_LANGUAGES=eng
OCR_MIN_NATIVE_TEXT_CHARS=25
PREVIEW_ZOOM=1.6
MIN_EXTRACTED_IMAGE_SIDE=32

# Optional for host-local PDF export. Docker sets this to /usr/bin/chromium-browser.
# Windows examples: C:\Program Files\Google\Chrome\Application\chrome.exe or C:\Program Files\Microsoft\Edge\Application\msedge.exe
PUPPETEER_EXECUTABLE_PATH=
